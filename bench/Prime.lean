set_option maxRecDepth 100000

namespace KernelDefBench.Prime

kernel_def isPrime (p : ℕ) : Bool := decide (Nat.Prime p)

theorem check251 : isPrime 251 = true := by
  decide +kernel

theorem check509 : isPrime 509 = true := by

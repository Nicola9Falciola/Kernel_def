import KernelDef

/-!
# Bench: `<` on `ℤ`, kernel form

`countBelow c l`, a count of the elements of `l` below `c`: `Int.blt'` in the kernel form,
`Int.decLt` (through `Int.sub`, `Int.add`, a matcher) in `Src.countBelow`.

Generated by `scripts/gen_bench.py`; metered by `scripts/kernel_cost.py`, with
`bench/IntLtSrc.lean` the same check through the readable definition. Not a library: run it with `lean`.
-/


set_option maxRecDepth 100000

namespace KernelDefBench.IntLt

/-- The elements of `l` below `c`. -/
kernel_def countBelow (c : ℤ) : List ℤ → ℕ
  | [] => 0
  | x :: l => (if x < c then 1 else 0) + countBelow c l


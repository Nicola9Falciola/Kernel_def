import KernelDef

/-!
# Bench: a bounded `∀`, readable

`noSquare n m`, whose source is `decide (∀ i < n, i * i ≠ m)`: `natAll` in the kernel form,
core's `Nat.decidableBallLT` (quadratic in the kernel) in `Src.noSquare`.

Generated by `scripts/gen_bench.py`; metered by `scripts/kernel_cost.py`, with
`bench/ForallLt.lean` the same check through the kernel form. Not a library: run it with `lean`.
-/


set_option maxRecDepth 100000

namespace KernelDefBench.ForallLt

kernel_def noSquare (n m : ℕ) : Bool := decide (∀ i < n, i * i ≠ m)

theorem check8 : Src.noSquare 256 7 = true := by
  decide +kernel

theorem check9 : Src.noSquare 512 7 = true := by
  decide +kernel

theorem check10 : Src.noSquare 1024 7 = true := by
  decide +kernel

end KernelDefBench.ForallLt

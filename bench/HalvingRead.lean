import KernelDef

/-!
# Bench: the halving read, kernel form

`sumRd Ks MKs d x n`: the sum of the `n` slots of `x`, read one by one by `rdH` at the
depth `d` of `n` (the least with `2 ^ (d + 3) ≥ n`).

Generated by `scripts/gen_bench.py`; metered by `scripts/kernel_cost.py`, with
`bench/HalvingReadSrc.lean` the same check through the readable definition. Not a library: run it with `lean`.
-/


namespace KernelDefBench.HalvingRead

/-- Slot `i` (of `Ks` bits, `MKs = 2 ^ Ks - 1`) of `x`, by `d` halvings and a plain read in a
block of eight slots. -/
kernel_def rdH (Ks MKs : ℕ) : ℕ → ℕ → ℕ → ℕ
  | 0, x, i => MKs &&& (x >>> (Ks * i))
  | d + 1, x, i =>
    if 1 <<< (d + 3) ≤ i then
      rdH Ks MKs d (x >>> (Ks * (1 <<< (d + 3)))) (i - 1 <<< (d + 3))
    else
      rdH Ks MKs d (x &&& (1 <<< (Ks * (1 <<< (d + 3))) - 1)) i

/-- The sum of the slots `0`, …, `n − 1` of `x`, each read by the halving read. -/
kernel_def sumRd (Ks MKs d x : ℕ) : ℕ → ℕ
  | 0 => 0
  | i + 1 => Src.rdH Ks MKs d x i + sumRd Ks MKs d x i

/-- 256 slots of 16 bits. -/
noncomputable def x256 : ℕ :=
  

theorem check256 : Nat.beq (sumRd 16 65535 5 x256 256) 8242181 = true := by
  decide +kernel

/-- 1024 slots of 16 bits. -/
noncomputable def x1024 : ℕ :=
  

theorem check1024 : Nat.beq (sumRd 16 65535 7 x1024 1024) 33606611 = true := by
  decide +kernel

/-- 4096 slots of 16 bits. -/
noncomputable def x4096 : ℕ :=
  

theorem check4096 : Nat.beq (sumRd 16 65535 9 x4096 4096) 134878107 = true := by
  decide +kernel

end KernelDefBench.HalvingRead
